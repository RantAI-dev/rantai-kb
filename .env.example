# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://kb:kb@localhost:5432/rantai_kb?schema=public"

SURREAL_DB_URL="ws://localhost:8000/rpc"
SURREAL_DB_USER="root"
SURREAL_DB_PASS="root"
SURREAL_DB_NAMESPACE="rantai"
SURREAL_DB_DATABASE="knowledge"

S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="kbadmin"
S3_SECRET_ACCESS_KEY="kbsecret123"
S3_BUCKET="rantai-kb"
S3_REGION="us-east-1"
S3_ENABLE_PATH_STYLE="1"

# Embeddings — any OpenAI-compatible endpoint (OpenRouter, TEI, vLLM, …)
KB_EMBEDDING_BASE_URL="https://openrouter.ai/api/v1/embeddings"
KB_EMBEDDING_API_KEY=""
KB_EMBEDDING_MODEL="qwen/qwen3-embedding-8b"
KB_EMBEDDING_DIM="4096"

# Fallback key for every OpenAI-compatible call (entity extraction, rerank, …)
OPENROUTER_API_KEY=""

# ── Optional ────────────────────────────────────────────────────────────────
PORT="8080"
KB_WORKER_ENABLED="true"

# Layout extraction for scanned/figure-heavy PDFs (all optional)
# KB_EXTRACT_MINERU_BASE_URL="http://mineru:8100"
# KB_MINERU_API_KEY=""
# KB_MISTRAL_OCR_KEY=""

